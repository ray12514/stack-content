# Rendered for {{ profile.system.name }} / OpenMPI toolchains (from mpi_providers)
toolchains:
{% for toolchain in (mpi_plan.get("openmpi") or {}).get("toolchains") or [] %}
  {{ toolchain.name }}:
{% for entry in toolchain.entries %}
    - spec: "{{ entry.spec }}"
      when: "{{ entry.when }}"
{% endfor %}
{% endfor %}
