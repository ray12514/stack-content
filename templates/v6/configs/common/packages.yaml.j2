# Rendered for {{ profile.system.name }} / {{ stack.name }}
packages:
  all:
    permissions:
      group: {{ deployment.access.group }}
      read: {{ deployment.access.read }}
      write: {{ deployment.access.write }}
{% if common_plan.default_mpi_provider %}
    providers:
      mpi: [{{ common_plan.default_mpi_provider }}]
{% endif %}
    prefer:
      - target={{ common_plan.target_prefer }}
{% for package in common_plan.externals %}
  {{ package.name }}:
    buildable: {{ package.buildable | lower }}
    externals:
{% for external in package.externals %}
      - spec: "{{ external.spec }}"
        prefix: {{ external.prefix }}
{% if external.modules %}
        modules:
{% for module in external.modules %}
          - {{ module }}
{% endfor %}
{% else %}
        modules: []
{% endif %}
{% endfor %}
{% endfor %}
