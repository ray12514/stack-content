#!/usr/bin/env bash
# shellcheck disable=SC1091

set -euo pipefail

# This also applies to the finite-operation guard before Spack is selected.
export PYTHONDONTWRITEBYTECODE=1

CSE_WORKSPACE_ROOT="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P
)"
readonly CSE_WORKSPACE_ROOT
readonly CSE_RECORDED_SYSTEM={{ values.system.name | yaml_scalar }}
readonly CSE_RECORDED_RELEASE={{ values.release | yaml_scalar }}
readonly CSE_RECORDED_ROLE={{ values.workspace.role | yaml_scalar }}
readonly CSE_RECORDED_GROUP={{ values.permissions.group | yaml_scalar }}
readonly CSE_RECORDED_SPACK_SOURCE={{ values.spack.source | yaml_scalar }}
readonly CSE_RECORDED_SPACK_VERSION={{ values.spack.version | yaml_scalar }}
readonly CSE_RECORDED_SPACK_TAG={{ values.spack.tag | yaml_scalar }}
readonly CSE_RECORDED_SPACK_COMMIT={{ values.spack.commit | yaml_scalar }}
readonly CSE_RECORDED_SPACK_MODE={{ values.spack.default_mode | yaml_scalar }}
readonly CSE_RECORDED_SHARED_SPACK_ROOT={{ values.spack.shared_root | yaml_scalar }}
readonly CSE_RECORDED_INITIAL_SPACK_ROOT={{ values.spack.initial_root | yaml_scalar }}

ORIGINAL_ARGS=("$@")
ACTION="tmux"
export CSE_PERMISSION_JOBS="${CSE_PERMISSION_JOBS:-4}"
REQUESTED_SPACK_MODE="auto"
REQUESTED_SURFACE="all"
REQUESTED_ENVIRONMENT=""
RECONCRETIZE=0
CSE_NODE_CONTEXT="${CSE_NODE_CONTEXT:-}"
ACTION_SET=0
CONTEXT_SET=0
OPERATOR_ARGS=()

usage() {
  cat <<'EOF'
Usage: ./cse-build [login|compute] [ACTION]
                   [--spack-mode auto|shared|local]
                   [--surface all|shared|platform]
                   [--permission-jobs 1..32]
                   [--environment COMPILER/LANE] [--reconcretize]

Node context:
  login      Use the reviewed login-node stages, with an executable WORKDIR
             fallback. Intended for bootstrap, concretize, and source fetch.
  compute    Use the reviewed compute-node stages, with a separate executable
             WORKDIR fallback. Intended for package installation.

The context may appear before or after ACTION. A prepared shell inherits its
context, so commands inside it do not need to repeat login or compute.

Actions:
  tmux        Create or reattach the release build session (default).
  shell       Enter a prepared interactive build shell without tmux.
  permissions Repair owned generated files and verify a quiescent handoff.
              Workers use disjoint subtrees (default 4; --permission-jobs 1..32).
  status      Show lockfile and installation status.
  concretize  Create missing locks. With --environment and --reconcretize,
              replace only that environment's lock, retaining a recovery record.
  resume      Continue --environment from its current lock; reuse installed
              hashes and keep module/view generation a separate action.
  verify      Verify configuration scopes and all existing lockfiles.
  fetch       Fetch all sources for the locked environments.
  install     Install, regenerate views, and refresh package modules in order.
  modules     Regenerate views and package modules for installed locked specs.
  module-preview [OPTIONS]
              Check module prerequisites or generate an isolated presentation
              from installed locks. Pass --check-only or --output NEW_DIRECTORY.
  overlay [apply|edit|status|restore] [OPTIONS]
              Correct package recipes in this workspace, retain backups, and
              report affected locks. See overlay --help.
  publish-modules
              Copy only the generated CSE front doors and lane selectors into
              the module root recorded by the current values. With restricted
              build values this is a team-review checkpoint, not public stack
              promotion. This never refreshes package modules, views,
              environments, locks, or installed prefixes.

Spack selection:
  auto        Use the recorded checkout when accessible; otherwise follow the
              workspace's recorded shared/local preference (default).
  shared      Use or provision the recorded shared CSE checkout.
  local       Use or provision $HOME/STACK_TESTING/spack/<version>.

Environment selection:
  all         Process both compiler surfaces in their recorded order (default).
  shared      Process only the shared GCC surface.
  platform    Process only the selected platform-compiler surface.

The surface selector applies to status, fetch, install, and modules. Select one
recorded environment for a focused concretize or resume. --reconcretize requires
--environment; other locks stay unchanged. Whole-workspace verify remains the
release gate. Finite actions serialize through the workspace maintenance lock;
coordinate any already-running older launcher or manual Spack command first.

See ./BUILDER-HANDOFF.md for the exact Spack commands behind each action.
EOF
}

fail() {
  printf 'cse-build: %s\n' "$*" >&2
  exit 2
}

note() {
  printf 'cse-build: %s\n' "$*"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    login|compute)
      [ "$CONTEXT_SET" -eq 0 ] || fail "only one node context may be selected"
      CSE_NODE_CONTEXT="$1"
      CONTEXT_SET=1
      ;;
    tmux|shell|permissions|status|concretize|resume|verify|fetch|install|modules|publish-modules)
      [ "$ACTION_SET" -eq 0 ] || fail "only one action may be selected"
      ACTION="$1"
      ACTION_SET=1
      ;;
    overlay|module-preview)
      [ "$ACTION_SET" -eq 0 ] || fail "only one action may be selected"
      ACTION="$1"
      ACTION_SET=1
      shift
      OPERATOR_ARGS=("$@")
      break
      ;;
    --permission-jobs)
      shift
      [ "$#" -gt 0 ] || fail "--permission-jobs requires a count from 1 to 32"
      CSE_PERMISSION_JOBS="$1"
      ;;
    --permission-jobs=*)
      CSE_PERMISSION_JOBS="${1#*=}"
      ;;
    --spack-mode)
      shift
      [ "$#" -gt 0 ] || fail "--spack-mode requires auto, shared, or local"
      REQUESTED_SPACK_MODE="$1"
      ;;
    --spack-mode=*)
      REQUESTED_SPACK_MODE="${1#*=}"
      ;;
    --surface)
      shift
      [ "$#" -gt 0 ] || fail "--surface requires all, shared, or platform"
      REQUESTED_SURFACE="$1"
      ;;
    --surface=*)
      REQUESTED_SURFACE="${1#*=}"
      ;;
    --environment)
      shift
      [ "$#" -gt 0 ] || fail "--environment requires a recorded compiler/lane"
      REQUESTED_ENVIRONMENT="$1"
      ;;
    --environment=*) REQUESTED_ENVIRONMENT="${1#*=}" ;;
    --reconcretize) RECONCRETIZE=1 ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
  shift
done

case "$CSE_PERMISSION_JOBS" in
  [1-9]|[12][0-9]|3[0-2]) ;;
  *) fail "--permission-jobs / CSE_PERMISSION_JOBS must be between 1 and 32" ;;
esac

case "$CSE_NODE_CONTEXT" in
  login|compute) ;;
  "") fail "select a node context: ./cse-build login or ./cse-build compute" ;;
  *) fail "inherited node context must be login or compute: $CSE_NODE_CONTEXT" ;;
esac

case "$REQUESTED_SPACK_MODE" in
  auto|shared|local) ;;
  *) fail "--spack-mode must be auto, shared, or local" ;;
esac

case "$REQUESTED_SURFACE" in
  all|shared|platform) ;;
  *) fail "--surface must be all, shared, or platform" ;;
esac

if [ "$REQUESTED_SURFACE" != all ]; then
  case "$ACTION" in
    status|fetch|install|modules) ;;
    *) fail "--surface applies only to status, fetch, install, and modules" ;;
  esac
fi

if [ -n "$REQUESTED_ENVIRONMENT" ]; then
  [ "$REQUESTED_SURFACE" = all ] || fail "choose --environment or --surface, not both"
  case "$ACTION" in
    status|concretize|resume|fetch|install|modules) ;;
    *) fail "--environment applies to status, concretize, resume, fetch, install, and modules" ;;
  esac
fi
if [ "$RECONCRETIZE" -eq 1 ]; then
  [ "$ACTION" = concretize ] && [ -n "$REQUESTED_ENVIRONMENT" ] || fail \
    "--reconcretize requires concretize --environment COMPILER/LANE"
fi
if [ "$ACTION" = resume ]; then
  [ -n "$REQUESTED_ENVIRONMENT" ] || fail "resume requires --environment COMPILER/LANE"
  [ "$CSE_NODE_CONTEXT" = compute ] || fail "resume requires compute context"
fi

if [ "$CSE_RECORDED_ROLE" != build ]; then
  case "$ACTION" in
    permissions|concretize|resume|fetch|install|overlay)
      fail "$ACTION is disabled for a publication workspace; use the cache-only \
publication procedure"
      ;;
  esac
fi

{% if values.workspace.role != 'build' or values.permissions.write != 'group' %}
[ "$ACTION" != permissions ] || fail "permissions requires a restricted group build workspace"
{% endif %}

case "$ACTION" in
  shell|tmux) ;;
  *)
    if [ -z "${CSE_MAINTENANCE_LOCK_FD:-}" ]; then
      exec python3 "$CSE_WORKSPACE_ROOT/scripts/workspace-build.py" guard \
        --workspace "$CSE_WORKSPACE_ROOT" -- bash "$CSE_WORKSPACE_ROOT/cse-build" \
        "${ORIGINAL_ARGS[@]}"
    fi
    python3 "$CSE_WORKSPACE_ROOT/scripts/workspace-build.py" check-lock \
      --workspace "$CSE_WORKSPACE_ROOT" || fail "workspace maintenance lock is invalid"
    ;;
esac

[ -z "${SPACK_ENV:-}" ] || fail \
  "start from a shell with no active Spack environment: $SPACK_ENV"
: "${HOME:?HOME must be set}"
: "${USER:?USER must be set}"
: "${WORKDIR:?WORKDIR must be set by the site environment}"

case "$WORKDIR" in
  /*) ;;
  *) fail "WORKDIR must be absolute: $WORKDIR" ;;
esac
[ -d "$WORKDIR" ] && [ -w "$WORKDIR" ] && [ -x "$WORKDIR" ] || fail \
  "WORKDIR must exist and be writable/searchable: $WORKDIR"
[ -r "$CSE_WORKSPACE_ROOT/workspace-manifest.yaml" ] || fail \
  "workspace manifest is missing under $CSE_WORKSPACE_ROOT"
[ -r "$CSE_WORKSPACE_ROOT/env/setup-build-env.sh" ] || fail \
  "workspace setup is missing under $CSE_WORKSPACE_ROOT"
[ -r "$CSE_WORKSPACE_ROOT/env/prepare-module-state.sh" ] || fail \
  "module-state preparation is missing under $CSE_WORKSPACE_ROOT"
[ -r "$CSE_WORKSPACE_ROOT/env/select-build-context.sh" ] || fail \
  "build-context selector is missing under $CSE_WORKSPACE_ROOT"
[ -w "$CSE_WORKSPACE_ROOT" ] || fail \
  "workspace is not writable by $USER: $CSE_WORKSPACE_ROOT"

case " $(id -Gn) " in
  *" $CSE_RECORDED_GROUP "*) ;;
  *) fail "builder is not in required group $CSE_RECORDED_GROUP" ;;
esac

source "$CSE_WORKSPACE_ROOT/env/select-build-context.sh"
cse_select_build_context "$CSE_NODE_CONTEXT" || fail \
  "could not select an executable $CSE_NODE_CONTEXT build stage"

readonly CSE_LOCAL_SPACK_ROOT="$HOME/STACK_TESTING/spack/$CSE_RECORDED_SPACK_VERSION"
SELECTED_SPACK_MODE="$REQUESTED_SPACK_MODE"
INHERITED_SPACK_MODE="${CSE_SPACK_MODE_SELECTED:-}"
case "$INHERITED_SPACK_MODE" in
  ""|shared|local) ;;
  *) fail "invalid inherited CSE Spack mode: $INHERITED_SPACK_MODE" ;;
esac

if [ "$SELECTED_SPACK_MODE" = auto ]; then
  if [ "$INHERITED_SPACK_MODE" = shared ] &&
     [ "${SPACK_ROOT:-}" = "$CSE_RECORDED_SHARED_SPACK_ROOT" ] &&
     [ -r "$CSE_RECORDED_SHARED_SPACK_ROOT/bin/spack" ]; then
    SELECTED_SPACK_MODE="shared"
    SPACK_ROOT="$CSE_RECORDED_SHARED_SPACK_ROOT"
  elif [ "$INHERITED_SPACK_MODE" = local ] &&
       [ "${SPACK_ROOT:-}" = "$CSE_LOCAL_SPACK_ROOT" ] &&
       [ -r "$CSE_LOCAL_SPACK_ROOT/bin/spack" ]; then
    SELECTED_SPACK_MODE="local"
    SPACK_ROOT="$CSE_LOCAL_SPACK_ROOT"
  elif [ "$CSE_RECORDED_INITIAL_SPACK_ROOT" = \
       "$CSE_RECORDED_SHARED_SPACK_ROOT" ] &&
     [ -r "$CSE_RECORDED_SHARED_SPACK_ROOT/bin/spack" ]; then
    SELECTED_SPACK_MODE="shared"
    SPACK_ROOT="$CSE_RECORDED_SHARED_SPACK_ROOT"
  elif [ "$CSE_RECORDED_INITIAL_SPACK_ROOT" = "$CSE_LOCAL_SPACK_ROOT" ] &&
       [ -r "$CSE_LOCAL_SPACK_ROOT/bin/spack" ]; then
    SELECTED_SPACK_MODE="local"
    SPACK_ROOT="$CSE_LOCAL_SPACK_ROOT"
  elif [ "$CSE_RECORDED_SPACK_MODE" = shared ] &&
       { [ ! -e "$CSE_RECORDED_SHARED_SPACK_ROOT" ] ||
         [ -r "$CSE_RECORDED_SHARED_SPACK_ROOT/bin/spack" ]; }; then
    SELECTED_SPACK_MODE="shared"
    SPACK_ROOT="$CSE_RECORDED_SHARED_SPACK_ROOT"
  else
    SELECTED_SPACK_MODE="local"
    SPACK_ROOT="$CSE_LOCAL_SPACK_ROOT"
  fi
elif [ "$SELECTED_SPACK_MODE" = shared ]; then
  SPACK_ROOT="$CSE_RECORDED_SHARED_SPACK_ROOT"
else
  SPACK_ROOT="$CSE_LOCAL_SPACK_ROOT"
fi

export SPACK_ROOT
export SPACK_DISABLE_LOCAL_CONFIG=true

prepare_shared_parent() {
  local parent tools_root
  parent="$(dirname "$SPACK_ROOT")"
  tools_root="$(dirname "$parent")"
  if [ ! -d "$parent" ]; then
    [ -d "$tools_root" ] && [ -w "$tools_root" ] || return 1
    mkdir -p "$parent"
    chgrp "$CSE_RECORDED_GROUP" "$parent"
    chmod 2770 "$parent"
  fi
  [ -w "$parent" ]
}

provision_spack() {
  [ ! -e "$SPACK_ROOT" ] || fail \
    "Spack root exists but is incomplete: $SPACK_ROOT"

  if [ "$SELECTED_SPACK_MODE" = shared ]; then
    if ! prepare_shared_parent; then
      if [ "$REQUESTED_SPACK_MODE" = auto ]; then
        note "shared checkout cannot be provisioned; using the builder-local checkout"
        SELECTED_SPACK_MODE="local"
        SPACK_ROOT="$CSE_LOCAL_SPACK_ROOT"
        export SPACK_ROOT
        provision_spack
        return
      fi
      fail "shared Spack parent is not an authorized writable CSE path: $(dirname "$SPACK_ROOT")"
    fi
  else
    mkdir -p "$(dirname "$SPACK_ROOT")"
  fi

  note "provisioning Spack $CSE_RECORDED_SPACK_TAG at $SPACK_ROOT"
  git clone --branch "$CSE_RECORDED_SPACK_TAG" --depth 1 \
    "$CSE_RECORDED_SPACK_SOURCE" "$SPACK_ROOT"

  if [ "$SELECTED_SPACK_MODE" = shared ]; then
    chgrp -R "$CSE_RECORDED_GROUP" "$SPACK_ROOT"
    chmod -R u+rX,g+rX,o-rwx,a-w "$SPACK_ROOT"
    find "$SPACK_ROOT" -xdev -type d -exec chmod g-s {} +
  fi
}

verify_spack() {
  [ -d "$SPACK_ROOT/.git" ] || fail "not a Spack Git checkout: $SPACK_ROOT"
  [ "$(git -C "$SPACK_ROOT" remote get-url origin)" = \
    "$CSE_RECORDED_SPACK_SOURCE" ] || fail "Spack source does not match the workspace"
  [ "$(git -C "$SPACK_ROOT" rev-parse HEAD)" = \
    "$CSE_RECORDED_SPACK_COMMIT" ] || fail "Spack commit does not match the workspace"
  [ "$(git -C "$SPACK_ROOT" rev-parse \
    "${CSE_RECORDED_SPACK_TAG}^{commit}")" = \
    "$CSE_RECORDED_SPACK_COMMIT" ] || fail \
    "Spack tag does not resolve to the workspace commit"
  case "$ACTION" in
    shell|tmux)
      if [ "$SELECTED_SPACK_MODE" = shared ] && [ -w "$CSE_SPACK_CANONICAL_ROOT" ]; then
        fail "shared Spack checkout root is writable: $SPACK_ROOT"
      fi
      return 0
      ;;
  esac
  [ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$SPACK_ROOT" \
    status --porcelain --untracked-files=all)" ] || fail "Spack checkout is dirty"
  [ -z "$(git -C "$SPACK_ROOT" \
    ls-files --others --ignored --exclude-standard)" ] || fail \
    "Spack checkout contains ignored mutable state"

  if [ "$SELECTED_SPACK_MODE" = shared ]; then
    local path setgid_path
    while IFS= read -r -d '' path; do
      [ ! -w "$path" ] || fail "shared Spack checkout is writable: $path"
    done < <(find "$CSE_SPACK_CANONICAL_ROOT" -xdev -print0)
    setgid_path="$(find "$CSE_SPACK_CANONICAL_ROOT" -xdev -type d \
      -perm -2000 -print -quit)"
    [ -z "$setgid_path" ] || fail \
      "shared Spack checkout contains an unexpected setgid directory: $setgid_path"
  fi
}

[ -e "$SPACK_ROOT" ] || provision_spack
CSE_SPACK_CANONICAL_ROOT="$(cd "$SPACK_ROOT" && pwd -P)"
readonly CSE_SPACK_CANONICAL_ROOT
if [ "$SELECTED_SPACK_MODE" = shared ] &&
   [ "$CSE_SPACK_CANONICAL_ROOT" != "$SPACK_ROOT" ]; then
  fail "shared Spack root must not resolve through a symlink: $SPACK_ROOT"
fi
verify_spack

export SPACK_USER_STATE_ROOT="$WORKDIR/$USER/cse-spack/$CSE_RECORDED_SYSTEM/$CSE_RECORDED_SPACK_VERSION"
export SPACK_USER_CACHE_PATH="$SPACK_USER_STATE_ROOT/cache/$CSE_NODE_CONTEXT/$REQUESTED_SURFACE"
export CSE_BUILD_WORKSPACE="$CSE_WORKSPACE_ROOT"
export CSE_INSTALL_TREE_ROOT={{ values.paths.install_tree | yaml_scalar }}
export CSE_SHARED_SOURCE_CACHE_ROOT={{ values.paths.source_cache | yaml_scalar }}
export CSE_SHARED_MISC_CACHE_ROOT={{ values.paths.misc_cache | yaml_scalar }}
CSE_OVERLAY_CACHE_KEY="$(python3 \
  "$CSE_BUILD_WORKSPACE/scripts/verify-overlay-inputs.py" --cache-key)" || fail \
  "could not select a cache for the reviewed overlay inputs"
export SPACK_MISC_CACHE_PATH="$CSE_SHARED_MISC_CACHE_ROOT/$USER-overlay-$CSE_OVERLAY_CACHE_KEY"
export CSE_VIEWS_ROOT={{ values.paths.views_root | yaml_scalar }}
export CSE_MODULES_ROOT={{ values.paths.modules_root | yaml_scalar }}
export CSE_BUILDCACHE_URL={{ values.buildcache.url | yaml_scalar }}
case "$CSE_BUILDCACHE_URL" in
  file:///*) export CSE_BUILDCACHE_ROOT="${CSE_BUILDCACHE_URL#file://}" ;;
  *) export CSE_BUILDCACHE_ROOT="" ;;
esac
export SPACK_BOOTSTRAP_ROOT="$SPACK_USER_STATE_ROOT/bootstrap"
export SPACK_GNUPGHOME="$SPACK_USER_STATE_ROOT/gpg"
install -d -m 0700 \
  "$SPACK_USER_CACHE_PATH" "$SPACK_BOOTSTRAP_ROOT" "$SPACK_GNUPGHOME"
grep -Fxq '  misc_cache: ${SPACK_MISC_CACHE_PATH}' \
  "$CSE_WORKSPACE_ROOT/configs/common/config.yaml" || fail \
  "workspace does not select the prepared shared misc cache; refresh workspace controls"

{% if values.workspace.role == 'build' and values.permissions.write == 'group' %}
source "$CSE_WORKSPACE_ROOT/env/share-generated-permissions.sh"
cse_normalize_shared_content_on_exit() {
  local status=$? permission_mode=repair
  trap - EXIT
  case "$ACTION" in status|concretize|verify) permission_mode=handoff ;; esac
  if ! cse_shared_permissions "$permission_mode" "$CSE_RECORDED_GROUP"; then
    printf 'cse-build: could not normalize shared generated content; stop writers and run permissions as the owning builder\n' >&2
    [ "$status" -ne 0 ] || status=2
  fi
  exit "$status"
}
cse_prepare_shared_generated_roots "$CSE_RECORDED_GROUP" || fail \
  "could not prepare shared generated roots; run permissions as the owning builder"
case "$ACTION" in
  permissions)
    cse_handoff_shared_generated_content "$CSE_RECORDED_GROUP" || fail \
      "shared generated content is not ready for builder handoff"
    exit 0
    ;;
  shell|tmux) ;;  # Explicit handoff follows manual work in these shells.
  *) trap cse_normalize_shared_content_on_exit EXIT ;;
esac
{% endif %}

source "$CSE_WORKSPACE_ROOT/env/prepare-module-state.sh"
cse_prepare_module_state || fail \
  "could not clear a preloaded external module before activating Spack"
source "$SPACK_ROOT/share/spack/setup-env.sh"
SPACK_VERSION_OUTPUT="$(spack --version)"
[ "${SPACK_VERSION_OUTPUT%% *}" = "$CSE_RECORDED_SPACK_VERSION" ] || fail \
  "activated Spack version does not match $CSE_RECORDED_SPACK_VERSION"
source "$CSE_WORKSPACE_ROOT/env/setup-build-env.sh"

export CSE_SPACK_MODE_SELECTED="$SELECTED_SPACK_MODE"

CSE_SHARED_ENVIRONMENTS=(
  "$SHARED_COMPILER_NAME/core"
  "$SHARED_COMPILER_NAME/common"
  "$SHARED_COMPILER_NAME/serial"
  "$SHARED_COMPILER_NAME/mpi-$SHARED_MPI_NAME"
)
CSE_PLATFORM_ENVIRONMENTS=(
  "$PLATFORM_COMPILER_NAME/core"
  "$PLATFORM_COMPILER_NAME/common"
  "$PLATFORM_COMPILER_NAME/serial"
  "$PLATFORM_COMPILER_NAME/mpi-$PLATFORM_MPI_NAME"
)
CSE_ENVIRONMENTS=(
  "${CSE_SHARED_ENVIRONMENTS[@]}"
  "${CSE_PLATFORM_ENVIRONMENTS[@]}"
)
case "$REQUESTED_SURFACE" in
  shared) CSE_ACTION_ENVIRONMENTS=("${CSE_SHARED_ENVIRONMENTS[@]}") ;;
  platform) CSE_ACTION_ENVIRONMENTS=("${CSE_PLATFORM_ENVIRONMENTS[@]}") ;;
  all) CSE_ACTION_ENVIRONMENTS=("${CSE_ENVIRONMENTS[@]}") ;;
esac
if [ -n "$REQUESTED_ENVIRONMENT" ]; then
  CSE_ENVIRONMENT_FOUND=0
  for environment in "${CSE_ENVIRONMENTS[@]}"; do
    [ "$environment" != "$REQUESTED_ENVIRONMENT" ] || CSE_ENVIRONMENT_FOUND=1
  done
  [ "$CSE_ENVIRONMENT_FOUND" -eq 1 ] || fail "unknown recorded environment: $REQUESTED_ENVIRONMENT"
  CSE_ACTION_ENVIRONMENTS=("$REQUESTED_ENVIRONMENT")
fi
readonly CSE_ENVIRONMENT_COUNT=8

checkpoint_summary() {
  local environment lock_count=0
  for environment in "${CSE_ENVIRONMENTS[@]}"; do
    if [ -f "$CSE_WORKSPACE_ROOT/environments/$environment/spack.lock" ]; then
      lock_count=$((lock_count + 1))
    fi
  done
  printf 'Workspace: %s\n' "$CSE_WORKSPACE_ROOT"
  printf 'System/release: %s / %s\n' \
    "$CSE_RECORDED_SYSTEM" "$CSE_RECORDED_RELEASE"
  printf 'Spack: %s (%s)\n' "$SPACK_ROOT" "$SELECTED_SPACK_MODE"
  printf 'Node context: %s (%s)\n' \
    "$CSE_NODE_CONTEXT" "$CSE_BUILD_NODE_TYPE"
  printf 'Build stage: %s\n' "$CSE_BUILD_STAGE"
  printf 'Builder misc cache: %s\n' "$SPACK_MISC_CACHE_PATH"
  printf 'Concrete locks: %s/%s\n' "$lock_count" "$CSE_ENVIRONMENT_COUNT"
  if [ "$lock_count" -eq 0 ]; then
    printf 'Next action: ./cse-build %s concretize\n' "$CSE_NODE_CONTEXT"
  elif [ "$lock_count" -eq "$CSE_ENVIRONMENT_COUNT" ]; then
    printf 'Next actions: ./cse-build %s verify, fetch, or install\n' \
      "$CSE_NODE_CONTEXT"
  else
    printf 'Next action: ./cse-build %s concretize (only missing locks are created)\n' \
      "$CSE_NODE_CONTEXT"
  fi
}

require_all_locks() {
  local environment missing=0
  for environment in "${CSE_ENVIRONMENTS[@]}"; do
    if [ ! -f "$CSE_WORKSPACE_ROOT/environments/$environment/spack.lock" ]; then
      printf 'Missing lock: %s\n' "$environment" >&2
      missing=1
    fi
  done
  [ "$missing" -eq 0 ] || fail "not all environments are concretized"
}

verify_scopes() {
  local environment generated_scope_count scope_output scope_path
  scope_output="$(COLUMNS=512 spack config scopes -vp)"
  if grep -Eq \
    '^(user|system)[[:space:]]+[^[:space:]]+[[:space:]]+active([[:space:]]|$)' \
    <<<"$scope_output"; then
    fail "unexpected active user/system Spack configuration scope"
  fi

  for environment in "${CSE_ENVIRONMENTS[@]}"; do
    scope_output="$(COLUMNS=512 spack \
      -e "$CSE_WORKSPACE_ROOT/environments/$environment" config scopes -vp)"
    if grep -Eq \
      '^(user|system|site)[[:space:]]+[^[:space:]]+[[:space:]]+active([[:space:]]|$)' \
      <<<"$scope_output"; then
      fail "unexpected active ambient scope in $environment"
    fi

    generated_scope_count="$(awk -v root="$CSE_WORKSPACE_ROOT/" \
      '$2 ~ /include/ && $3 == "active" && index($4, root) == 1 {count++} \
       END {print count + 0}' <<<"$scope_output")"
    [ "$generated_scope_count" -gt 0 ] || fail \
      "no active workspace include scope in $environment"

    while IFS= read -r scope_path; do
      case "$scope_path" in
        "$CSE_WORKSPACE_ROOT"/*|"$SPACK_ROOT"/etc/spack/defaults/*|\
          "$CSE_SPACK_CANONICAL_ROOT"/etc/spack/defaults/*) ;;
        *) fail "unexpected active include path in $environment: $scope_path" ;;
      esac
    done < <(awk '$2 ~ /include/ && $3 == "active" {print $4}' \
      <<<"$scope_output")
  done
}

verify_workspace_inputs() {
  spack python "$CSE_WORKSPACE_ROOT/scripts/verify-workspace-inputs.py"
}

verify_locks() {
  require_all_locks
  spack python "$CSE_WORKSPACE_ROOT/scripts/verify-lockfiles.py"
}

show_status() {
  local environment
  checkpoint_summary
  printf 'Selected surface: %s\n' "$REQUESTED_SURFACE"
  for environment in "${CSE_ACTION_ENVIRONMENTS[@]}"; do
    printf '\n[%s]\n' "$environment"
    if [ -f "$CSE_WORKSPACE_ROOT/environments/$environment/spack.lock" ]; then
      spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" find -lv
    else
      printf 'not concretized\n'
    fi
  done
}

concretize_missing() {
  local environment
  local flags=()
  [ "$RECONCRETIZE" -eq 0 ] || flags=(--reconcretize)
  for environment in "${CSE_ACTION_ENVIRONMENTS[@]}"; do
    spack python "$CSE_WORKSPACE_ROOT/scripts/workspace-build.py" concretize \
      --workspace "$CSE_WORKSPACE_ROOT" --environment "$environment" "${flags[@]}"
  done
  if [ -z "$REQUESTED_ENVIRONMENT" ]; then
    verify_locks
  fi
}

check_overlay_build_inputs() {
  local environment
  local selected=()
  for environment in "${CSE_ACTION_ENVIRONMENTS[@]}"; do
    selected+=(--environment "$environment")
  done
  spack python "$CSE_WORKSPACE_ROOT/scripts/workspace-build.py" check \
    --workspace "$CSE_WORKSPACE_ROOT" "${selected[@]}"
  spack python "$CSE_WORKSPACE_ROOT/scripts/workspace-overlay.py" check \
    --workspace "$CSE_WORKSPACE_ROOT" --action build "${selected[@]}"
}

fetch_selected() {
  local environment
  verify_locks
  note "fetch surface: $REQUESTED_SURFACE"
  for environment in "${CSE_ACTION_ENVIRONMENTS[@]}"; do
    note "fetching $environment"
    spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" fetch -D
  done
}

install_selected() {
  local environment
  check_overlay_build_inputs
  verify_locks
  note "install surface: $REQUESTED_SURFACE"
  for environment in "${CSE_ACTION_ENVIRONMENTS[@]}"; do
    note "building $environment"
    spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" fetch -D
    spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" \
      install --only-concrete -j "$BUILD_JOBS" --fail-fast
    refresh_environment_modules "$environment"
  done
}

refresh_environment_modules() {
  local environment="$1"
  spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" env view regenerate
  spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" \
    module tcl refresh --delete-tree -y
  case "$environment" in
    */core)
      # This set shares the default Core root; retain its refreshed modules.
      spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" \
        module tcl --name core_independent refresh -y
      ;;
  esac
{% for surface in [values.shared, values.platform] %}
{% if surface.compiler.source == 'build' %}
  if [ "$environment" = {{ (surface.compiler.name ~ '/core') | yaml_scalar }} ]; then
    spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" \
      module tcl --name compiler_producer refresh --delete-tree -y
  fi
{% endif %}
{% if surface.mpi.source == 'build' %}
  if [ "$environment" = {{ (surface.compiler.name ~ '/mpi-' ~ surface.mpi.name) | yaml_scalar }} ]; then
    spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" \
      module tcl --name mpi_producer refresh --delete-tree -y
  fi
{% endif %}
{% endfor %}
}

refresh_selected_modules() {
  local environment
  verify_locks
  note "module refresh surface: $REQUESTED_SURFACE"
  for environment in "${CSE_ACTION_ENVIRONMENTS[@]}"; do
    spack -e "$CSE_WORKSPACE_ROOT/environments/$environment" python -c '
import sys
import os
import spack.environment as ev
missing = [spec for spec in ev.active_environment().all_specs()
           if not spec.external and (not spec.installed or not os.path.isdir(str(spec.prefix)))]
if missing:
    sys.stderr.write("Missing installed specs: " + ", ".join(str(spec) for spec in missing) + "\n")
    sys.exit(1)
' || fail "finish installing $environment before refreshing package modules"
  done
  for environment in "${CSE_ACTION_ENVIRONMENTS[@]}"; do
    refresh_environment_modules "$environment"
  done
}

publish_module_file() {
  local source="$1" relative="$2" destination temporary
  case "$relative" in
    /*|*../*|../*|*/..|..|"") fail "unsafe presentation-module target: $relative" ;;
  esac
  source="$CSE_WORKSPACE_ROOT/$source"
  case "$relative" in
    cse/*) destination="$CSE_MODULES_ROOT/entrances/$relative" ;;
    *) destination="$CSE_MODULES_ROOT/$relative" ;;
  esac
  [ -f "$source" ] && [ ! -L "$source" ] || fail \
    "presentation-module source is missing or unsafe: $source"
  mkdir -p "$(dirname "$destination")"
  temporary="$(dirname "$destination")/.${destination##*/}.cse-publish.$$"
  [ ! -e "$temporary" ] || fail \
    "stale presentation-module publish file exists: $temporary"
  if ! cp -p -- "$source" "$temporary"; then
    rm -f -- "$temporary"
    fail "could not stage presentation module: $relative"
  fi
  if ! mv -f -- "$temporary" "$destination"; then
    rm -f -- "$temporary"
    fail "could not publish presentation module: $relative"
  fi
  note "published presentation module: $relative"
}

require_presentation_directory() {
  [ -d "$1" ] || fail \
    "presentation prerequisite is missing; finish package installation first: $1"
}

publish_presentation_modules() {
  verify_locks

{% for surface in (values.shared, values.platform) %}
  require_presentation_directory \
    {{ (values.paths.views_root ~ '/' ~ surface.compiler.name ~ '/foundation') | yaml_scalar }}
  require_presentation_directory \
    {{ (values.paths.modules_root ~ '/' ~ surface.compiler.name ~ '/core') | yaml_scalar }}
  require_presentation_directory \
    {{ (values.paths.modules_root ~ '/' ~ surface.compiler.name ~ '/common') | yaml_scalar }}
  require_presentation_directory \
    {{ (values.paths.modules_root ~ '/' ~ surface.compiler.name ~ '/serial') | yaml_scalar }}
  require_presentation_directory \
    {{ (values.paths.modules_root ~ '/' ~ surface.compiler.name ~ '/mpi-' ~ surface.mpi.name) | yaml_scalar }}
{% if surface.compiler.source == 'build' %}
  [ -f {{ (values.paths.modules_root ~ '/' ~ surface.compiler.name ~ '/compiler/' ~ surface.compiler.name ~ '/' ~ surface.compiler.version) | yaml_scalar }} ] || fail \
    "generated compiler module is missing for {{ surface.compiler.name }}@{{ surface.compiler.version }}"
{% endif %}
{% if surface.mpi.source == 'build' %}
  [ -f {{ (values.paths.modules_root ~ '/' ~ surface.compiler.name ~ '/mpi-' ~ surface.mpi.name ~ '-provider/' ~ surface.mpi.name ~ '/' ~ surface.mpi.version) | yaml_scalar }} ] || fail \
    "generated MPI provider module is missing for {{ surface.mpi.name }}@{{ surface.mpi.version }}"
{% endif %}
{% endfor %}

  publish_module_file \
    {{ ('modulefiles/cse/' ~ values.shared.compiler.public_name) | yaml_scalar }} \
    {{ ('cse/' ~ values.shared.compiler.public_name) | yaml_scalar }}
  publish_module_file \
    {{ ('modulefiles/' ~ values.shared.compiler.name ~ '/lanes/Serial') | yaml_scalar }} \
    {{ (values.shared.compiler.name ~ '/lanes/Serial') | yaml_scalar }}
  publish_module_file \
    {{ ('modulefiles/cse/' ~ values.platform.compiler.public_name) | yaml_scalar }} \
    {{ ('cse/' ~ values.platform.compiler.public_name) | yaml_scalar }}
  publish_module_file \
    {{ ('modulefiles/' ~ values.platform.compiler.name ~ '/lanes/Serial') | yaml_scalar }} \
    {{ (values.platform.compiler.name ~ '/lanes/Serial') | yaml_scalar }}

{% if values.shared.compiler.source == 'build' and values.shared.mpi.source == 'external' %}
  note "withheld {{ values.shared.compiler.name }}/lanes/MPI: native multi-node validation is required"
{% if values.shared.mpi.consumer is defined %}
  note "candidate facts: $CSE_WORKSPACE_ROOT/presentation/mpi-consumer-candidates.yaml"
{% else %}
  note "candidate facts are missing; regenerate reviewed build values and refresh controls"
{% endif %}
{% else %}
  publish_module_file \
    {{ ('modulefiles/' ~ values.shared.compiler.name ~ '/lanes/MPI') | yaml_scalar }} \
    {{ (values.shared.compiler.name ~ '/lanes/MPI') | yaml_scalar }}
{% endif %}
  publish_module_file \
    {{ ('modulefiles/' ~ values.platform.compiler.name ~ '/lanes/MPI') | yaml_scalar }} \
    {{ (values.platform.compiler.name ~ '/lanes/MPI') | yaml_scalar }}
  note "consumer entrance root: $CSE_MODULES_ROOT/entrances"
  note "clean consumer shell: module use \"$CSE_MODULES_ROOT/entrances\""
  note "register only this entrance root; any older site MODULEPATH registration is unchanged"
}

# Full validation belongs to finite work. Interactive entry remains bounded by
# declared configuration and roots rather than the generated file count.
case "$ACTION" in
  shell|tmux) ;;
  *)
    verify_workspace_inputs
    verify_scopes
    ;;
esac

case "$ACTION" in
  tmux)
    checkpoint_summary
    if [ -n "${TMUX:-}" ]; then
      note "already inside tmux; opening the prepared shell in this session"
      exec bash --noprofile \
        --rcfile "$CSE_WORKSPACE_ROOT/env/workspace-shell.rc" -i
    elif command -v tmux >/dev/null 2>&1; then
      readonly CSE_TMUX_SESSION="cse-$CSE_RECORDED_SYSTEM-$CSE_RECORDED_RELEASE-$CSE_NODE_CONTEXT"
      note "creating or attaching tmux session $CSE_TMUX_SESSION"
      exec tmux new-session -A -s "$CSE_TMUX_SESSION" \
        -c "$CSE_WORKSPACE_ROOT" \
        "exec bash --noprofile --rcfile \"$CSE_WORKSPACE_ROOT/env/workspace-shell.rc\" -i"
    else
      note "tmux is unavailable; opening the prepared shell directly"
      exec bash --noprofile \
        --rcfile "$CSE_WORKSPACE_ROOT/env/workspace-shell.rc" -i
    fi
    ;;
  shell)
    checkpoint_summary
    printf '\nOpening a prepared CSE build shell without tmux. Exit it with: exit\n'
    exec bash --noprofile \
      --rcfile "$CSE_WORKSPACE_ROOT/env/workspace-shell.rc" -i
    ;;
  status) show_status ;;
  concretize) concretize_missing ;;
  resume)
    spack python "$CSE_WORKSPACE_ROOT/scripts/workspace-build.py" resume \
      --workspace "$CSE_WORKSPACE_ROOT" --environment "$REQUESTED_ENVIRONMENT"
    ;;
  verify) verify_locks ;;
  fetch) fetch_selected ;;
  install) install_selected ;;
  modules) refresh_selected_modules ;;
  overlay)
    spack python "$CSE_WORKSPACE_ROOT/scripts/workspace-overlay.py" "${OPERATOR_ARGS[@]}"
    ;;
  module-preview)
    spack python "$CSE_WORKSPACE_ROOT/scripts/module-preview.py" "${OPERATOR_ARGS[@]}"
    ;;
  publish-modules) publish_presentation_modules ;;
esac
