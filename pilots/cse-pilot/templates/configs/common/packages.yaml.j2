packages:
  cmake:
    prefer:
      - '@{{ data.roster.cmake.build_default }}'
  zlib-api:
    require:
      - zlib target={{ values.architecture.target }}
  zlib:
    require:
      - '@1.3.1 target={{ values.architecture.target }}'
  xz:
    require:
      - '@5.4.6 target={{ values.architecture.target }}'
  zstd:
    require:
      - '@1.5.6 target={{ values.architecture.target }}'
  miniforge3:
    require:
      - target={{ values.architecture.binary_target }}
  all:
    prefer:
      - target={{ values.architecture.target }}
    permissions:
      read: {{ values.permissions.read | yaml_scalar }}
      write: {{ values.permissions.write | yaml_scalar }}
      group: {{ values.permissions.group | yaml_scalar }}
