packages:
  cmake:
    prefer:
      - '@{{ data.roster.cmake.build_default }}'
  zlib-api:
    require:
      - zlib target={{ values.architecture.target }}
  zlib:
    require:
      - '@1.3.1 target={{ values.architecture.target }}'
  xz:
    require:
      - '@5.4.6 target={{ values.architecture.target }}'
  zstd:
    require:
      - '@1.5.6 target={{ values.architecture.target }}'
  miniforge3:
    require:
      - target={{ values.architecture.binary_target }}
  # Keep approved Python roots and transitive Python dependencies identical
  # across Core, Common, Serial, and MPI lane solves.
  python:
    require:
      - +ssl
  iconv:
    require:
      - glibc
  # The pinned Boost recipe leaves compiled libraries disabled unless each
  # library variant is requested. Use its standard compiled-library set for
  # both public Boost versions and for consumers such as Dakota.
  boost:
    require:
      - +atomic+chrono+date_time+exception+filesystem+graph+iostreams+locale+log+math+program_options+random+regex+serialization+system+test+thread+timer+wave
      # Boost.MPI requires Boost.Python beginning with Boost 1.87. Bind that
      # package-local edge without constraining unrelated Python dependencies
      # elsewhere in the MPI root DAG.
      - spec: ^python@3.12.13
        when: +mpi
  # XCB protocol generation has a build-only Python dependency. Keep it on an
  # approved interpreter without applying a root-wide Python constraint.
  xcb-proto:
    require:
      - ^python@3.12.13
  blas:
    require:
      - netlib-lapack@3.12.1
  lapack:
    require:
      - netlib-lapack@3.12.1
  all:
    prefer:
      - target={{ values.architecture.target }}
    permissions:
      read: {{ values.permissions.read | yaml_scalar }}
      write: {{ values.permissions.write | yaml_scalar }}
      group: {{ values.permissions.group | yaml_scalar }}
