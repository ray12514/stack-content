#!/usr/bin/env python3
"""Verify the concrete DAG invariants for the CSE Initial Conversion Trials."""

import json
import sys
from collections import defaultdict
from pathlib import Path
from typing import Dict, List, Set, Tuple


WORKSPACE = Path(__file__).resolve().parents[1]
DAKOTA_OVERLAY = (
    WORKSPACE
    / "package-repos"
    / "spack_repo"
    / "cse_trials"
    / "packages"
    / "dakota"
)
BUILD_CMAKE = {{ data.roster.cmake.build_default | tojson }}
PUBLIC_CMAKE = {{ data.roster.cmake.current | tojson }}
EXPECTED_PYTHON_VERSIONS = {"3.8.20", "3.10.20", "3.12.13"}
EXPECTED_CPU_TARGET = {{ values.architecture.target | tojson }}
BINARY_TARGET_EXCEPTIONS = {
    "miniforge3": {{ values.architecture.binary_target | tojson }},
}
EXPECTED_ENVIRONMENTS = {
    {{ (values.shared.compiler.name ~ '/core') | tojson }},
    {{ (values.shared.compiler.name ~ '/common') | tojson }},
    {{ (values.shared.compiler.name ~ '/serial') | tojson }},
    {{ (values.shared.compiler.name ~ '/mpi-' ~ values.shared.mpi.name) | tojson }},
    {{ (values.platform.compiler.name ~ '/core') | tojson }},
    {{ (values.platform.compiler.name ~ '/common') | tojson }},
    {{ (values.platform.compiler.name ~ '/serial') | tojson }},
    {{ (values.platform.compiler.name ~ '/mpi-' ~ values.platform.mpi.name) | tojson }},
}
MPI_BY_SURFACE = {
    {{ values.shared.compiler.name | tojson }}: (
        {{ values.shared.mpi.name | tojson }}, {{ values.shared.mpi.version | tojson }}
    ),
    {{ values.platform.compiler.name | tojson }}: (
        {{ values.platform.mpi.name | tojson }}, {{ values.platform.mpi.version | tojson }}
    ),
}
MPI_SOURCE_BY_SURFACE = {
    {{ values.shared.compiler.name | tojson }}: {{ values.shared.mpi.source | tojson }},
    {{ values.platform.compiler.name | tojson }}: {{ values.platform.mpi.source | tojson }},
}
MPI_RUNTIME_DEPENDENCIES = {
    "cray-mpich": {"libfabric", "cray-pmi"},
}
COMPILER_BY_SURFACE = {
    {{ values.shared.compiler.name | tojson }}: (
        {{ values.shared.compiler.name | tojson }}, {{ values.shared.compiler.version | tojson }}
    ),
    {{ values.platform.compiler.name | tojson }}: (
        {{ values.platform.compiler.name | tojson }}, {{ values.platform.compiler.version | tojson }}
    ),
}
GCC_BUILD_COMPILER = (
    {{ values.shared.compiler.build_with.name | tojson }}, {{ values.shared.compiler.build_with.version | tojson }}
)
GCC_PRODUCER_COORDINATE = (
    {{ values.shared.compiler.name | tojson }}
    + "@"
    + {{ values.shared.compiler.version | tojson }}
)
SHARED_COMPILER_KEY = (
    {{ values.shared.compiler.name | tojson }},
    {{ values.shared.compiler.name | tojson }},
    {{ values.shared.compiler.version | tojson }},
)
GCC_ENVIRONMENTS = {
    environment
    for environment in EXPECTED_ENVIRONMENTS
    if environment.startswith({{ (values.shared.compiler.name ~ '/') | tojson }})
}
NETCDF_CHAINS = {
    ("netcdf-c", "4.9.2"): ("4.9.2", "1.10.6"),
    ("netcdf-c", "4.10.0"): ("4.10.0", "2.1.0"),
    ("netcdf-fortran", "4.6.0"): ("4.9.2", "1.10.6"),
    ("netcdf-fortran", "4.6.2"): ("4.10.0", "2.1.0"),
}
NETCDF_CXX_CHAINS = {("4.9.2", "1.10.6"), ("4.10.0", "2.1.0")}


def workspace_input_errors() -> List[str]:
    errors: List[str] = []
    recipe_path = DAKOTA_OVERLAY / "package.py"
    patch_path = DAKOTA_OVERLAY / "boost-system-header-only.patch"
    try:
        recipe = recipe_path.read_text(encoding="utf-8")
    except OSError as error:
        errors.append(f"Dakota overlay recipe is unavailable: {error}")
        recipe = ""
    try:
        patch = patch_path.read_text(encoding="utf-8")
    except OSError as error:
        errors.append(f"Dakota overlay patch is unavailable: {error}")
        patch = ""

    declaration = 'patch("boost-system-header-only.patch", when="@6.23.0:6.24.0")'
    if recipe and declaration not in recipe:
        errors.append(
            "Dakota overlay recipe does not apply the Boost.System patch to "
            "Dakota 6.23.0 and 6.24.0"
        )

    required_patch_fragments = (
        "diff --git a/cmake/DakotaFindSystemTPLs.cmake",
        "diff --git a/src/plugins/CMakeLists.txt",
        "diff --git a/src/surrogates/unit/CMakeLists.txt",
        "-  set(dakota_boost_libs program_options regex serialization system)",
        "+  set(dakota_boost_libs program_options regex serialization)",
        "-find_package(Boost 1.70 REQUIRED COMPONENTS system)",
        "-    PUBLIC Boost::system stdc++fs",
        "-      PUBLIC Boost::system",
        "-  LINK_LIBS dakota_surrogates Boost::system )",
        "-    LINK_LIBS dakota_surrogates Boost::system )",
    )
    missing_fragments = [
        fragment for fragment in required_patch_fragments if fragment not in patch
    ]
    if patch and missing_fragments:
        errors.append(
            "Dakota overlay is incomplete; refresh the workspace package repository "
            "before concretizing or building. Missing patch fragments: "
            + ", ".join(repr(fragment) for fragment in missing_fragments)
        )

    for environment in sorted(GCC_ENVIRONMENTS):
        spack_yaml = WORKSPACE / "environments" / environment / "spack.yaml"
        try:
            rendered = spack_yaml.read_text(encoding="utf-8")
        except OSError as error:
            errors.append(f"{environment}: generated spack.yaml is unavailable: {error}")
            continue
        producer_lines = [
            line.split("#", 1)[0]
            for line in rendered.splitlines()
            if GCC_PRODUCER_COORDINATE in line.split("#", 1)[0]
            and f"%{GCC_PRODUCER_COORDINATE}" not in line.split("#", 1)[0]
        ]
        if not any("+binutils" in line for line in producer_lines):
            errors.append(
                f"{environment}: GCC producer {GCC_PRODUCER_COORDINATE} "
                "does not enable +binutils; regenerate the workspace from current "
                "Stack Content before concretizing or building"
            )
        duplicate_constraint = f"%{GCC_PRODUCER_COORDINATE}"
        duplicate_lines = [
            line.split("#", 1)[0].strip()
            for line in rendered.splitlines()
            if duplicate_constraint in line.split("#", 1)[0]
        ]
        if duplicate_lines:
            errors.append(
                f"{environment}: generated spack.yaml repeats the managed GCC "
                f"producer as a downstream compiler constraint "
                f"{duplicate_constraint}; downstream groups must inherit the exact "
                f"producer through needs: {duplicate_lines}"
            )

        group_lines = rendered.splitlines()
        for index, line in enumerate(group_lines):
            stripped = line.strip()
            if not stripped.startswith("- group: "):
                continue
            group_indent = len(line) - len(line.lstrip())
            group_name = stripped.split(":", 1)[1].strip()
            if group_name not in {"foundation", "core", "build-tools", "mpi", "payload"}:
                continue
            block: List[str] = []
            for candidate in group_lines[index + 1 :]:
                candidate_stripped = candidate.strip()
                candidate_indent = len(candidate) - len(candidate.lstrip())
                if (
                    candidate_stripped.startswith("- group: ")
                    and candidate_indent == group_indent
                ):
                    break
                block.append(candidate_stripped)
            needs_lines = [entry for entry in block if entry.startswith("needs:")]
            if not any("compiler" in entry for entry in needs_lines):
                errors.append(
                    f"{environment}: group {group_name!r} does not inherit the "
                    "managed GCC producer through needs"
                )

    shared_compiler_config = (
        WORKSPACE / "configs" / "surfaces" / "shared" / "compiler.yaml"
    )
    try:
        shared_policy = shared_compiler_config.read_text(encoding="utf-8")
    except OSError as error:
        errors.append(f"shared GCC compiler policy is unavailable: {error}")
        shared_policy = ""
    if shared_policy:
        managed_provider = GCC_PRODUCER_COORDINATE + "+binutils"
        provider_lines = [
            line.split("#", 1)[0]
            for line in shared_policy.splitlines()
            if GCC_PRODUCER_COORDINATE in line.split("#", 1)[0]
        ]
        managed_providers = [
            line for line in provider_lines if managed_provider in line
        ]
        if len(managed_providers) != 3 or len(provider_lines) != 3:
            errors.append(
                "shared GCC language-provider policy must prefer "
                f"{managed_provider} exactly three times for c, cxx, and fortran; "
                f"found {provider_lines}"
            )
    return errors


def load_lock(path: Path) -> Tuple[Dict, Dict]:
    with path.open(encoding="utf-8") as stream:
        lock = json.load(stream)
    version = lock.get("_meta", {}).get("lockfile-version")
    if version != 7:
        raise ValueError(f"{path}: expected Spack 1.2 lockfile version 7, got {version!r}")
    return lock, lock.get("concrete_specs", {})


def node_version(node: Dict) -> str:
    return str(node.get("version", ""))


def reachable(start_hash: str, nodes: Dict) -> Set[str]:
    pending = [start_hash]
    seen: Set[str] = set()
    while pending:
        current = pending.pop()
        if current in seen:
            continue
        seen.add(current)
        for dependency in nodes.get(current, {}).get("dependencies", []):
            dependency_hash = dependency.get("hash")
            if dependency_hash:
                pending.append(dependency_hash)
    return seen


def package_versions(hashes: Set[str], nodes: Dict, name: str) -> Set[str]:
    return {
        node_version(nodes[dag_hash])
        for dag_hash in hashes
        if dag_hash in nodes and nodes[dag_hash].get("name") == name
    }


def package_hashes(
    hashes: Set[str], nodes: Dict, name: str, version: str
) -> Set[str]:
    return {
        dag_hash
        for dag_hash in hashes
        if dag_hash in nodes
        and nodes[dag_hash].get("name") == name
        and node_version(nodes[dag_hash]) == version
    }


def direct_language_providers(node: Dict, nodes: Dict) -> Set[Tuple[str, str]]:
    providers: Set[Tuple[str, str]] = set()
    for dependency in node.get("dependencies", []):
        virtuals = set(dependency.get("parameters", {}).get("virtuals", []))
        if not virtuals.intersection({"c", "cxx", "fortran"}):
            continue
        provider = nodes.get(dependency.get("hash"), {})
        providers.add((provider.get("name", ""), node_version(provider)))
    return providers


def direct_language_provider_hashes(node: Dict) -> Set[str]:
    return {
        dependency.get("hash")
        for dependency in node.get("dependencies", [])
        if dependency.get("hash")
        and set(dependency.get("parameters", {}).get("virtuals", [])).intersection(
            {"c", "cxx", "fortran"}
        )
    }


def verify_shared_gcc_provider_hashes(
    gcc_producer_hashes: Set[str],
    language_provider_hashes: Dict[Tuple[str, str, str], Set[str]],
    errors: List[str],
) -> None:
    shared_compiler_hashes = language_provider_hashes.get(
        SHARED_COMPILER_KEY, set()
    )
    if len(shared_compiler_hashes) != 1:
        errors.append(
            f"{SHARED_COMPILER_KEY[0]}@{SHARED_COMPILER_KEY[2]}: downstream roots "
            f"use compiler hashes {sorted(shared_compiler_hashes)}; expected one"
        )
    if len(gcc_producer_hashes) == 1 and shared_compiler_hashes != gcc_producer_hashes:
        errors.append(
            f"{SHARED_COMPILER_KEY[0]}@{SHARED_COMPILER_KEY[2]}: downstream compiler "
            f"hashes {sorted(shared_compiler_hashes)} do not match the +binutils "
            f"producer hash {sorted(gcc_producer_hashes)}"
        )


def main(workspace_only: bool = False) -> int:
    errors = workspace_input_errors()
    if workspace_only:
        if errors:
            for error in errors:
                print(f"ERROR: {error}", file=sys.stderr)
            return 1
        print(
            "Workspace input verification passed: current CSE Dakota overlay and "
            "GCC producer/needs inputs."
        )
        return 0

    lock_paths = sorted(WORKSPACE.glob("environments/*/*/spack.lock"))
    actual = {
        str(path.parent.relative_to(WORKSPACE / "environments")) for path in lock_paths
    }
    missing = EXPECTED_ENVIRONMENTS - actual
    extra = actual - EXPECTED_ENVIRONMENTS
    if missing:
        errors.append(f"missing lockfiles: {', '.join(sorted(missing))}")
    if extra:
        errors.append(f"unexpected lockfiles: {', '.join(sorted(extra))}")

    reused_hashes: Dict[Tuple[str, str, str], Set[str]] = defaultdict(set)
    language_provider_hashes: Dict[Tuple[str, str, str], Set[str]] = defaultdict(set)
    gcc_producer_hashes: Set[str] = set()
    cmake_roots_by_environment: Dict[str, Set[str]] = defaultdict(set)
    python_roots_by_environment: Dict[str, Set[str]] = defaultdict(set)
    python_hashes_by_surface: Dict[Tuple[str, str], Set[str]] = defaultdict(set)
    lapack_hashes_by_surface: Dict[Tuple[str, str], Set[str]] = defaultdict(set)

    for path in lock_paths:
        environment = str(path.parent.relative_to(WORKSPACE / "environments"))
        surface, lane = environment.split("/", 1)
        try:
            lock, nodes = load_lock(path)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            errors.append(str(error))
            continue

        roots_by_group: Dict[str, List[Dict]] = defaultdict(list)
        for dag_hash, node in nodes.items():
            name = node.get("name")
            version = node_version(node)
            if name == "python" and not node.get("external"):
                if version not in EXPECTED_PYTHON_VERSIONS:
                    errors.append(
                        f"{environment}: unexpected Python node {version} "
                        f"({dag_hash[:7]}); approved versions are "
                        f"{sorted(EXPECTED_PYTHON_VERSIONS)}"
                    )
                python_hashes_by_surface[(surface, version)].add(dag_hash)
            if name == "netlib-lapack" and version == "3.12.1":
                lapack_hashes_by_surface[(surface, version)].add(dag_hash)
            if node.get("external"):
                continue
            target = (node.get("arch") or {}).get("target")
            expected_target = BINARY_TARGET_EXCEPTIONS.get(
                node.get("name"), EXPECTED_CPU_TARGET
            )
            if target != expected_target:
                errors.append(
                    f"{environment}: built node {node.get('name')}@{node_version(node)} "
                    f"({dag_hash[:7]}) targets {target!r}; expected {expected_target!r}"
                )
        for root in lock.get("roots", []):
            roots_by_group[root.get("group", "default")].append(root)
            node = nodes.get(root.get("hash"), {})
            name = node.get("name")
            version = node_version(node)
            if root.get("group") == "foundation":
                reused_hashes[(surface, name, version)].add(root.get("hash"))
            if name == "cmake" and root.get("group") in {"core", "build-tools"}:
                reused_hashes[(surface, name, version)].add(root.get("hash"))
                cmake_roots_by_environment[environment].add(version)
            if name == "python" and root.get("group") == "core":
                python_roots_by_environment[environment].add(version)

            providers = direct_language_providers(node, nodes)
            for provider_hash in direct_language_provider_hashes(node):
                provider = nodes.get(provider_hash, {})
                language_provider_hashes[
                    (surface, provider.get("name", ""), node_version(provider))
                ].add(provider_hash)
            group = root.get("group")
            if group == "compiler":
                expected_provider = GCC_BUILD_COMPILER
                if surface != {{ values.shared.compiler.name | tojson }}:
                    errors.append(f"{environment}: external surface has a compiler producer")
                if (node.get("parameters") or {}).get("binutils") is not True:
                    errors.append(
                        f"{environment}: GCC producer {root.get('spec')} does not "
                        "enable +binutils"
                    )
                gcc_producer_hashes.add(root.get("hash"))
            elif group in {"foundation", "build-tools", "core", "payload", "mpi"}:
                expected_provider = COMPILER_BY_SURFACE[surface]
            else:
                expected_provider = None
            if expected_provider is not None and providers != {expected_provider}:
                errors.append(
                    f"{environment}: {group} root {root.get('spec')} uses language "
                    f"provider(s) {sorted(providers)}; expected {expected_provider}"
                )

        expected_cmake_roots = {BUILD_CMAKE, PUBLIC_CMAKE}
        if cmake_roots_by_environment[environment] != expected_cmake_roots:
            errors.append(
                f"{environment}: CMake roots are "
                f"{sorted(cmake_roots_by_environment[environment])}; expected "
                f"{sorted(expected_cmake_roots)}"
            )
        if (
            lane == "core"
            and python_roots_by_environment[environment] != EXPECTED_PYTHON_VERSIONS
        ):
            errors.append(
                f"{environment}: Python roots are "
                f"{sorted(python_roots_by_environment[environment])}; expected "
                f"{sorted(EXPECTED_PYTHON_VERSIONS)}"
            )

        payload_roots = roots_by_group.get("payload", [])
        payload_roots_by_name = {
            nodes.get(root.get("hash"), {}).get("name"): root
            for root in payload_roots
        }
        cxx_chains: Set[Tuple[str, str]] = set()
        has_cxx_roots = False
        for root in payload_roots:
            node = nodes.get(root.get("hash"), {})
            name = node.get("name")
            version = node_version(node)
            graph = reachable(root["hash"], nodes)
            netcdf_c_versions = package_versions(graph, nodes, "netcdf-c")
            hdf5_versions = package_versions(graph, nodes, "hdf5")
            if (name, version) in NETCDF_CHAINS:
                expected_netcdf_c, expected_hdf5 = NETCDF_CHAINS[(name, version)]
                if netcdf_c_versions != {expected_netcdf_c} or hdf5_versions != {
                    expected_hdf5
                }:
                    errors.append(
                        f"{environment}: {name}@{version} resolves NetCDF-C "
                        f"expected {expected_netcdf_c} and {expected_hdf5}"
                    )
            if name == "netcdf-cxx4" and version == "4.3.1":
                has_cxx_roots = True
                if len(netcdf_c_versions) == 1 and len(hdf5_versions) == 1:
                    cxx_chains.add(
                        (next(iter(netcdf_c_versions)), next(iter(hdf5_versions)))
                    )

        if has_cxx_roots and cxx_chains != NETCDF_CXX_CHAINS:
            errors.append(
                f"{environment}: NetCDF-CXX4 chains are {sorted(cxx_chains)}; "
                f"expected {sorted(NETCDF_CXX_CHAINS)}"
            )

        if lane.startswith("serial"):
            selected_mpis = {name for name, _ in MPI_BY_SURFACE.values()}
            for root in payload_roots:
                graph = reachable(root["hash"], nodes)
                found = sorted(
                    name
                    for name in selected_mpis
                    if package_versions(graph, nodes, name)
                )
                if found:
                    errors.append(
                        f"{environment}: Serial root {root.get('spec')} reaches MPI "
                        f"provider(s) {', '.join(found)}"
                    )

        if lane.startswith("mpi-"):
            mpi_name, mpi_version = MPI_BY_SURFACE[surface]
            mpi_source = MPI_SOURCE_BY_SURFACE[surface]
            mpi_group_roots = roots_by_group.get("mpi", [])
            expected_mpi_hash = None
            if mpi_source == "build":
                if len(mpi_group_roots) != 1:
                    errors.append(
                        f"{environment}: built MPI lane has {len(mpi_group_roots)} "
                        "MPI producer roots; expected one"
                    )
                else:
                    expected_mpi_hash = mpi_group_roots[0].get("hash")
            elif mpi_group_roots:
                errors.append(
                    f"{environment}: external MPI lane unexpectedly has an MPI "
                    "producer root"
                )

            selected_mpi_hashes: Set[str] = set()
            for root in payload_roots:
                graph = reachable(root["hash"], nodes)
                versions = package_versions(graph, nodes, mpi_name)
                if versions != {mpi_version}:
                    errors.append(
                        f"{environment}: MPI root {root.get('spec')} resolves "
                        f"{mpi_name} versions {sorted(versions)}; expected {mpi_version}"
                    )
                provider_hashes = package_hashes(
                    graph, nodes, mpi_name, mpi_version
                )
                selected_mpi_hashes.update(provider_hashes)
                if expected_mpi_hash and provider_hashes != {expected_mpi_hash}:
                    errors.append(
                        f"{environment}: MPI root {root.get('spec')} uses provider "
                        f"hashes {sorted(provider_hashes)}; expected producer "
                        f"{expected_mpi_hash}"
                    )
                if mpi_source == "build":
                    for dependency_name in MPI_RUNTIME_DEPENDENCIES.get(mpi_name, set()):
                        if not package_versions(graph, nodes, dependency_name):
                            errors.append(
                                f"{environment}: MPI root {root.get('spec')} does not "
                                f"reach required runtime {dependency_name}"
                            )
            if len(selected_mpi_hashes) != 1:
                errors.append(
                    f"{environment}: payload roots use MPI provider hashes "
                    f"{sorted(selected_mpi_hashes)}; expected one"
                )
            elif mpi_source == "external":
                selected_mpi_hash = next(iter(selected_mpi_hashes))
                if not nodes.get(selected_mpi_hash, {}).get("external"):
                    errors.append(
                        f"{environment}: MPI provider {selected_mpi_hash} is not external"
                    )

        for root in payload_roots:
            graph = reachable(root["hash"], nodes)
            cmake_versions = package_versions(graph, nodes, "cmake")
            if cmake_versions and cmake_versions != {BUILD_CMAKE}:
                errors.append(
                    f"{environment}: payload root {root.get('spec')} resolves CMake "
                    f"{sorted(cmake_versions)}; expected only {BUILD_CMAKE}"
                )

            node = nodes.get(root.get("hash"), {})
            if node.get("name") == "dakota":
                expected_boost_root = payload_roots_by_name.get("boost")
                expected_boost_hash = (
                    expected_boost_root.get("hash") if expected_boost_root else None
                )
                boost_hashes = package_hashes(graph, nodes, "boost", "1.90.0")
                if not expected_boost_hash or boost_hashes != {expected_boost_hash}:
                    errors.append(
                        f"{environment}: Dakota root {root.get('spec')} uses Boost "
                        f"hashes {sorted(boost_hashes)}; expected the direct "
                        f"boost@1.90.0 MPI root {expected_boost_hash}"
                    )
                python_versions = package_versions(graph, nodes, "python")
                if python_versions != {"3.12.13"}:
                    errors.append(
                        f"{environment}: Dakota root {root.get('spec')} resolves "
                        f"Python {sorted(python_versions)}; expected 3.12.13"
                    )
                lapack_hashes = package_hashes(
                    graph, nodes, "netlib-lapack", "3.12.1"
                )
                if len(lapack_hashes) != 1:
                    errors.append(
                        f"{environment}: Dakota root {root.get('spec')} resolves "
                        f"netlib-lapack hashes {sorted(lapack_hashes)}; expected one "
                        "3.12.1 producer"
                    )

    for (surface, name, version), hashes in sorted(reused_hashes.items()):
        if len(hashes) != 1:
            errors.append(
                f"{surface} producer {name}@{version} has {len(hashes)} hashes: "
                f"{', '.join(sorted(hashes))}"
            )

    if len(gcc_producer_hashes) != 1:
        errors.append(
            "repeated GCC producer roots have hashes "
            f"{sorted(gcc_producer_hashes)}; expected one"
        )

    for (surface, version), hashes in sorted(python_hashes_by_surface.items()):
        if len(hashes) != 1:
            errors.append(
                f"{surface} Python {version} has {len(hashes)} hashes across "
                f"environments: {', '.join(sorted(hashes))}"
            )

    for (surface, version), hashes in sorted(lapack_hashes_by_surface.items()):
        if len(hashes) != 1:
            errors.append(
                f"{surface} netlib-lapack {version} has {len(hashes)} hashes "
                f"across environments: {', '.join(sorted(hashes))}"
            )

    verify_shared_gcc_provider_hashes(
        gcc_producer_hashes, language_provider_hashes, errors
    )

    if errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        return 1

    print(
        "Lockfile verification passed: eight environments, shared producer "
        f"hashes, CMake {BUILD_CMAKE} build dependencies, Core Python roots "
        f"{sorted(EXPECTED_PYTHON_VERSIONS)} with no extra interpreters, "
        "Dakota producer reuse, NetCDF/HDF5 chains, "
        f"compiler surfaces, MPI boundaries, CPU target {EXPECTED_CPU_TARGET}, "
        "and reviewed binary-target exceptions."
    )
    return 0


if __name__ == "__main__":
    arguments = sys.argv[1:]
    if arguments not in ([], ["--workspace-only"]):
        print("usage: verify-lockfiles.py [--workspace-only]", file=sys.stderr)
        raise SystemExit(2)
    raise SystemExit(main(workspace_only=bool(arguments)))
