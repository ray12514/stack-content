# shellcheck shell=bash

cse_cache_permissions_error() {
  printf 'cse-build: %s\n' "$*" >&2
  return 1
}

cse_set_shared_cache_directory_mode() {
  chmod 2770 "$1" 2>/dev/null || chmod 0770 "$1"
}

cse_normalize_shared_misc_cache() {
  local builder_cache="$1"
  local cse_group="$2"
  local shared_root current_uid bad_path path

  case "$builder_cache" in
    /*) ;;
    *) cse_cache_permissions_error \
      "shared builder cache must be absolute: $builder_cache"; return 1 ;;
  esac
  [ -n "$cse_group" ] || {
    cse_cache_permissions_error "shared builder cache group is empty"
    return 1
  }

  shared_root="$(dirname "$builder_cache")"
  for path in "$shared_root" "$builder_cache"; do
    [ ! -L "$path" ] || {
      cse_cache_permissions_error "shared builder cache path is a symlink: $path"
      return 1
    }
    if [ ! -e "$path" ]; then
      install -d -m 2770 -g "$cse_group" "$path" || {
        cse_cache_permissions_error "could not create shared builder cache path: $path"
        return 1
      }
    fi
    [ -d "$path" ] || {
      cse_cache_permissions_error "shared builder cache path is not a directory: $path"
      return 1
    }
    if [ -O "$path" ]; then
      if ! chgrp "$cse_group" "$path" || \
        ! cse_set_shared_cache_directory_mode "$path"; then
        cse_cache_permissions_error "could not set shared builder cache access: $path"
        return 1
      fi
    fi
  done

  bad_path="$(find "$shared_root" -maxdepth 0 \
    \( ! -group "$cse_group" -o ! -perm -0070 -o \
       -perm -0004 -o -perm -0002 -o -perm -0001 \) -print -quit)" || {
      cse_cache_permissions_error "could not inspect shared misc-cache root: $shared_root"
      return 1
    }
  [ -z "$bad_path" ] || {
    cse_cache_permissions_error \
      "shared misc-cache root does not enforce CSE-group access: $bad_path"
    return 1
  }

  current_uid="$(id -u)"
  find "$builder_cache" -xdev -uid "$current_uid" -type d \
    -exec chgrp "$cse_group" {} + || {
      cse_cache_permissions_error \
        "could not assign shared builder cache directories to $cse_group: $builder_cache"
      return 1
    }
  while IFS= read -r -d '' path; do
    cse_set_shared_cache_directory_mode "$path" || {
      cse_cache_permissions_error \
        "could not normalize shared builder cache directory: $path"
      return 1
    }
  done < <(find "$builder_cache" -xdev -uid "$current_uid" -type d -print0)
  find "$builder_cache" -xdev -uid "$current_uid" -type f \
    -exec chgrp "$cse_group" {} + || {
      cse_cache_permissions_error \
        "could not assign shared builder cache files to $cse_group: $builder_cache"
      return 1
    }
  find "$builder_cache" -xdev -uid "$current_uid" -type f -perm -0100 \
    -exec chmod 0770 {} + || {
      cse_cache_permissions_error \
        "could not normalize executable cache files: $builder_cache"
      return 1
    }
  find "$builder_cache" -xdev -uid "$current_uid" -type f ! -perm -0100 \
    -exec chmod 0660 {} + || {
      cse_cache_permissions_error \
        "could not normalize shared builder cache files: $builder_cache"
      return 1
    }

  bad_path="$(find "$builder_cache" -xdev \
    \( -type d -o -type f \) ! -group "$cse_group" -print -quit)" || {
      cse_cache_permissions_error "could not inspect shared builder cache: $builder_cache"
      return 1
    }
  [ -z "$bad_path" ] || {
    cse_cache_permissions_error \
      "cache entry is not assigned to group $cse_group: $bad_path"
    return 1
  }

  bad_path="$(find "$builder_cache" -xdev -type d \
    ! -perm -0070 -print -quit)" || {
      cse_cache_permissions_error "could not inspect cache directory modes: $builder_cache"
      return 1
    }
  [ -z "$bad_path" ] || {
    cse_cache_permissions_error \
      "cache directory is not group-readable/writable/searchable: $bad_path"
    return 1
  }

  bad_path="$(find "$builder_cache" -xdev -type f \
    ! -perm -0060 -print -quit)" || {
      cse_cache_permissions_error "could not inspect cache file modes: $builder_cache"
      return 1
    }
  [ -z "$bad_path" ] || {
    cse_cache_permissions_error "cache file is not group-readable/writable: $bad_path"
    return 1
  }

  bad_path="$(find "$builder_cache" -xdev \( -type d -o -type f \) \
    \( -perm -0004 -o -perm -0002 -o -perm -0001 \) -print -quit)" || {
      cse_cache_permissions_error "could not inspect cache access audience: $builder_cache"
      return 1
    }
  [ -z "$bad_path" ] || {
    cse_cache_permissions_error "cache entry is accessible outside CSE: $bad_path"
    return 1
  }
}
