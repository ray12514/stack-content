# shellcheck shell=bash
# shellcheck disable=SC1091

source "$SPACK_ROOT/share/spack/setup-env.sh"
source "$CSE_BUILD_WORKSPACE/env/setup-build-env.sh"
{% if values.workspace.role == 'build' and values.permissions.write == 'group' %}
source "$CSE_BUILD_WORKSPACE/env/share-generated-permissions.sh"

# Login and shell exit must not scale with the number of installed/generated files.
cse_prepare_shared_generated_roots "$CSE_GROUP" || exit 2
printf 'Before builder handoff, stop writers and run ./cse-build login permissions.\n'
{% endif %}

cd "$CSE_BUILD_WORKSPACE" || exit 2

printf '\nCSE build workspace is active.\n'
printf 'Workspace: %s\n' "$CSE_BUILD_WORKSPACE"
printf 'Spack: %s\n' "$SPACK_ROOT"
printf 'Node context: %s (%s)\n' "$CSE_NODE_CONTEXT" "$CSE_BUILD_NODE_TYPE"
printf 'Build stage: %s\n' "$CSE_BUILD_STAGE"
printf 'Run ./cse-build --help for status, concretize, fetch, and install actions.\n\n'

PS1="[cse:{{ values.system.name }}:{{ values.release }}:$CSE_NODE_CONTEXT] ${PS1:-\\u@\\h:\\w\\$ }"
