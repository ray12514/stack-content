#!/usr/bin/env bash

# Names and ordering for the initialized CSE trial workspace. This file does
# not activate Spack or load platform modules; the builder does those explicitly.
: "${WORKDIR:?WORKDIR must name the builder work directory}"
: "${CSE_NODE_CONTEXT:?select login or compute through cse-build}"
: "${CSE_BUILD_NODE_TYPE:?cse-build must select a profiled node type}"
: "${CSE_BUILD_STAGE:?cse-build must select an executable build stage}"
case "$WORKDIR" in
  /*) ;;
  *) echo "WORKDIR must be an absolute path: $WORKDIR" >&2; return 2 2>/dev/null || exit 2 ;;
esac
if [[ ! -d "$WORKDIR" || ! -w "$WORKDIR" || ! -x "$WORKDIR" ]]; then
  echo "WORKDIR must exist and be writable/searchable: $WORKDIR" >&2
  return 2 2>/dev/null || exit 2
fi

export CSE_GROUP={{ values.permissions.group | yaml_scalar }}
export CSE_SHARED_MISC_CACHE_ROOT={{ values.paths.misc_cache | yaml_scalar }}
case " $(id -Gn) " in
  *" $CSE_GROUP "*) ;;
  *)
    echo "builder is not a member of required group $CSE_GROUP" >&2
    return 2 2>/dev/null || exit 2
    ;;
esac

{% if values.permissions.write == 'group' %}
# Restricted build workspace: collaborative and private to CSE.
umask 0007
{% elif values.permissions.read == 'world' %}
# Publication workspace: consumer-readable, writable only by its owner.
umask 0022
{% else %}
# Owner-writable, group-readable workspace.
umask 0027
{% endif %}

export CSE_CPU_TARGET={{ values.architecture.target | yaml_scalar }}
export CSE_SYSTEM_NAME={{ values.system.name | yaml_scalar }}
export CSE_TRIAL_RELEASE={{ values.release | yaml_scalar }}
export CSE_SPACK_SOURCE={{ values.spack.source | yaml_scalar }}
export CSE_SPACK_VERSION={{ values.spack.version | yaml_scalar }}
export CSE_SPACK_TAG={{ values.spack.tag | yaml_scalar }}
export CSE_SPACK_COMMIT={{ values.spack.commit | yaml_scalar }}
export CSE_SPACK_DEFAULT_MODE={{ values.spack.default_mode | yaml_scalar }}
export CSE_SPACK_SHARED_ROOT={{ values.spack.shared_root | yaml_scalar }}
export CSE_SPACK_INITIAL_ROOT={{ values.spack.initial_root | yaml_scalar }}
export SHARED_COMPILER_NAME={{ values.shared.compiler.name | yaml_scalar }}
export SHARED_MPI_NAME={{ values.shared.mpi.name | yaml_scalar }}
export PLATFORM_COMPILER_NAME={{ values.platform.compiler.name | yaml_scalar }}
export PLATFORM_MPI_NAME={{ values.platform.mpi.name | yaml_scalar }}
export BUILD_JOBS={{ values.build_jobs }}
