# shellcheck shell=bash

cse_shared_permissions_error() {
  printf 'cse-build: %s\n' "$*" >&2
  return 1
}

cse_shared_permissions() {
  local mode="$1" cse_group="$2"
  local args=(
    --mode "$mode" --group "$cse_group" --jobs "${CSE_PERMISSION_JOBS:-4}"
    --tree "$CSE_BUILD_WORKSPACE"
    --root "$CSE_INSTALL_TREE_ROOT" --exclude-tree "$CSE_INSTALL_TREE_ROOT"
    --root "$CSE_SHARED_MISC_CACHE_ROOT"
    --tree "$SPACK_MISC_CACHE_PATH"
    --tree "$CSE_SHARED_SOURCE_CACHE_ROOT"
    --tree "$CSE_VIEWS_ROOT"
    --tree "$CSE_MODULES_ROOT"
  )
  if [ -n "$CSE_BUILDCACHE_ROOT" ]; then
    args+=(--tree "$CSE_BUILDCACHE_ROOT")
  fi
  if [ -n "${SPACK_USER_STATE_ROOT:-}" ]; then
    args+=(--exclude-tree "$SPACK_USER_STATE_ROOT")
  fi
  if [ -n "${CSE_BUILD_STAGE:-}" ]; then
    args+=(--exclude-tree "$CSE_BUILD_STAGE")
  fi
  if [ "$mode" = roots ]; then
    args+=(--quiet --create-root "$CSE_SHARED_MISC_CACHE_ROOT" --create-root "$SPACK_MISC_CACHE_PATH")
  fi
  python3 "$CSE_BUILD_WORKSPACE/scripts/workspace-permissions.py" "${args[@]}"
}

cse_prepare_shared_generated_roots() {
  cse_shared_permissions roots "$1"
}

cse_normalize_shared_generated_content() {
  cse_shared_permissions repair "$1"
}

cse_handoff_shared_generated_content() {
  cse_shared_permissions handoff "$1"
}

cse_verify_shared_generated_content() {
  cse_shared_permissions verify "$1"
}
